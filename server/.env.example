# Banco SQLite (ficheiro no diretório de trabalho; em produção, use path absoluto ou volume)
DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development
# CORS: origem(s) do Vite, vírgula se forem várias. Em **produção (NODE_ENV=production)**,
# TEM de definir URLs absolutas reais, ex.:
# CORS_ORIGIN="https://app.seudominio.com"
# Com localhost, inclua 127.0.0.1:5173 se o browser o usar
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Atrás de Nginx, Cloudflare, etc. (X-Forwarded-For)
TRUST_PROXY=0
# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
API_PREFIX="/api"
API_VERSION="v1"
# `=1` serve `client/dist` a partir do mesmo processo (após `npm run build` na raiz)
SERVE_CLIENT=0
CLIENT_DIST_PATH=../client/dist
