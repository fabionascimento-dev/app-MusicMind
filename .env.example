# Copie para server/.env e ajuste os valores.
# Raiz: podemos manter documentação; variáveis efetivas ficam no pacote `server/`.

# --- Servidor (server/.env) ---
# DATABASE_URL="file:./prisma/dev.db"
# PORT=4000
# NODE_ENV=development
# CORS_ORIGIN="http://localhost:5173"
# TRUST_PROXY=0
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
# API_PREFIX="/api"
# API_VERSION="v1"
# SERVE_CLIENT=0
# CLIENT_DIST_PATH="../client/dist"

# --- Cliente (client/.env) ---
# VITE_API_BASE_URL="http://localhost:4000"
