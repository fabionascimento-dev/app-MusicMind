# Aumenta resiliência a falhas intermitentes de rede ao descarregar pacotes
# (EAI_AGAIN, timeouts) — o npm volta a tentar o mesmo pedido HTTP/HTTPS.
registry=https://registry.npmjs.org/
fetch-retries=10
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
maxsockets=15
prefer-online=true
